# Скопируйте этот файл в .env и поменяйте значения. Файл .env НЕ попадает в git.

# Секрет для подписи токенов: длинная случайная строка (минимум 32 символа).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=замените-на-длинную-случайную-строку-минимум-32-символа

# Первый администратор (создаётся командой: python -m app.scripts.create_admin)
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=придумайте-надёжный-пароль

# Адрес фронтенда (несколько — через запятую)
CORS_ORIGINS=http://localhost:5173

# База данных. По умолчанию SQLite в backend/data/app.db
# PostgreSQL: DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dasti_guyo
# DATABASE_URL=sqlite:///data/app.db

# Минимум одобренных примеров на жест для обучения
MIN_SAMPLES_PER_GESTURE=20
